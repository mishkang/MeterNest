{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeterNest",
  "mainBinaryName": "MeterNest",
  "version": "0.8.7",
  "identifier": "com.meternest.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "resources": [
      "resources/**/*",
      "bin/meternest-wake-helper"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
